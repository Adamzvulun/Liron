{
  "subject": "arabic",
  "source": "waymark",
  "license": "Our own: tales written by us from the words each chapter teaches, checked against the deck (ADR 0012)",
  "items": [
    {
      "id": "tale:road:2",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 1,
        "regular": "road:2",
        "title": "Salim at the gate",
        "lines": [
          {
            "arabic": "مرْحبا! صباح الخيْر!",
            "latin": "márɧaba! ʂabāɧ ilxēr!",
            "english": "Hi! Good morning!"
          },
          {
            "arabic": "أنا سليم. أهْلا وسهْلا! وإنْتَ؟",
            "latin": "ána salīm. áhla w sáhla! w ínta?",
            "english": "I’m Salim. Welcome! And you?"
          },
          {
            "arabic": "أنا بْخيْر، شُكْراً.",
            "latin": "ána b-xēr, šúkran.",
            "english": "I’m fine, thanks."
          },
          {
            "arabic": "هالوَلد وهالبِنِت؟ طيِّب، أهْلا!",
            "latin": "halwálad w halbínit? ʈáyyib, áhla!",
            "english": "This boy and this girl? Okay, welcome!"
          },
          {
            "arabic": "تْفضّل! … باي، باي!",
            "latin": "tfáɖɖal! … bāy, bāy!",
            "english": "Here you are! … Bye, bye!"
          }
        ]
      }
    },
    {
      "id": "tale:road:3",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 2,
        "regular": "road:3",
        "title": "Umm Khalil asks",
        "lines": [
          {
            "arabic": "مين إنْتَ؟ ومِن ويْن؟",
            "latin": "mīn ínta? w min wēn?",
            "english": "Who are you? And where from?"
          },
          {
            "arabic": "أنا أمّ خليل.",
            "latin": "ána umm xalīl.",
            "english": "I’m Umm Khalil."
          },
          {
            "arabic": "خليل اِبْني، وهُوَّ مِتْجوِّز.",
            "latin": "xalīl íbni, w húwwa midjáwwiz.",
            "english": "Khalil is my son, and he’s married."
          },
          {
            "arabic": "وبِنْتو هان، معي.",
            "latin": "w bíntu hān, má3i.",
            "english": "And his daughter is here, with me."
          },
          {
            "arabic": "وإنْتَ؟ مِتْجوِّز؟ لا؟ ليْش؟!",
            "latin": "w ínta? midjáwwiz? laʔ? lēš?!",
            "english": "And you? Married? No? Why?!"
          }
        ]
      }
    },
    {
      "id": "tale:road:4",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 3,
        "regular": "road:4",
        "title": "Yusuf keeps time",
        "lines": [
          {
            "arabic": "أنا يوسف. اليوْم الجُّمْعة.",
            "latin": "ána yūsif. ilyōm ijjúm3a.",
            "english": "I’m Yusuf. Today is Friday."
          },
          {
            "arabic": "الصُّبِح، السّاعة سبْعة: واحد، تْنيْن، تلاتة…",
            "latin": "iʂʂúbiɧ, issā3a sáb3a: wāɧad, tnēn, talāta…",
            "english": "In the morning, at seven: one, two, three…"
          },
          {
            "arabic": "المسا، السّاعة عشرة: ساعة ساعة، دْقيقة دْقيقة.",
            "latin": "ilmása, issā3a 3ášara: sā3a sā3a, dgīga dgīga.",
            "english": "In the evening, at ten: hour by hour, minute by minute."
          },
          {
            "arabic": "بُكْرا السّبِت، وأنا هان مِن الصُّبِح.",
            "latin": "búkra issábit, w ána hān min iʂʂúbiɧ.",
            "english": "Tomorrow is Saturday, and I’m here from the morning."
          }
        ]
      }
    },
    {
      "id": "tale:road:5",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 4,
        "regular": "road:5",
        "title": "Rana’s basket",
        "lines": [
          {
            "arabic": "أنا جعان!",
            "latin": "ána ja3ān!",
            "english": "I’m hungry!"
          },
          {
            "arabic": "تْفضّل: خُبِز وجِبْنة وبيْض.",
            "latin": "tfáɖɖal: xúbiz w jíbna w bēɖ.",
            "english": "Here you are: bread, cheese and eggs."
          },
          {
            "arabic": "وقهْوة؟ لا، شاي مع حليب.",
            "latin": "w gáhwa? laʔ, šāy ma3 ɧalīb.",
            "english": "And coffee? No, tea with milk."
          },
          {
            "arabic": "الخُبِز زاكي!",
            "latin": "ilxúbiz zāki!",
            "english": "The bread is delicious!"
          },
          {
            "arabic": "الحْساب؟ لا لا، هالفْطور مِنّي.",
            "latin": "ilɧsāb? laʔ laʔ, halfʈūr mínni.",
            "english": "The bill? No, no, this breakfast is on me."
          }
        ]
      }
    },
    {
      "id": "tale:road:6",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 5,
        "regular": "road:6",
        "title": "Abu Fadi’s drawing",
        "lines": [
          {
            "arabic": "هالدّار دار فادي.",
            "latin": "haddār dār fādi.",
            "english": "This house is Fadi’s house."
          },
          {
            "arabic": "فيها صالوْن ومطْبخ وحمّام.",
            "latin": "fīha ʂālōn w máʈbax w ɧammām.",
            "english": "It has a living room, a kitchen and a bathroom."
          },
          {
            "arabic": "وفي غُرْفة فيها تخِت وشُبّاك.",
            "latin": "w fi ɣúrfa fīha táxit w šubbāk.",
            "english": "And there’s a room with a bed and a window."
          },
          {
            "arabic": "فادي بِنام هان، وبِصْحى الصُّبِح.",
            "latin": "fādi bnām hān, w biʂɧa iʂʂúbiɧ.",
            "english": "Fadi sleeps here, and wakes up in the morning."
          },
          {
            "arabic": "وأنا؟ أنا معي المُفْتاح.",
            "latin": "w ána? ána má3i ilmuftāɧ.",
            "english": "And me? I have the key."
          }
        ]
      }
    },
    {
      "id": "tale:road:7",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 6,
        "regular": "road:7",
        "title": "Nasser shows the way",
        "lines": [
          {
            "arabic": "بِدّك المطار؟",
            "latin": "bíddak ilmaʈār?",
            "english": "You want the airport?"
          },
          {
            "arabic": "مِن هان: قُدّامك، شْمال، يَمين.",
            "latin": "min hān: guddāmak, šmāl, yamīn.",
            "english": "From here: straight on, left, right."
          },
          {
            "arabic": "وَقْتيْش الطّيّارة؟ السّاعة تِسْعة؟",
            "latin": "wagtēš iʈʈayyāra? issā3a tís3a?",
            "english": "When’s the plane? At nine?"
          },
          {
            "arabic": "طيِّب، تاكْسي.",
            "latin": "ʈáyyib, tāksi.",
            "english": "Okay, a taxi."
          },
          {
            "arabic": "السّوّاق بِسوق، وإنْتَ بْتوصل.",
            "latin": "issawwāg bisūg, w ínta btūʂal.",
            "english": "The driver drives, and you arrive."
          }
        ]
      }
    },
    {
      "id": "tale:road:8",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 7,
        "regular": "road:8",
        "title": "Leila paints you",
        "lines": [
          {
            "arabic": "اِبْتسم!",
            "latin": "ibtísim!",
            "english": "Smile!"
          },
          {
            "arabic": "عْيونك سود، وشعرك أسْوَد.",
            "latin": "3yūnak sūd, w šá3rak áswad.",
            "english": "Your eyes are black, and your hair is black."
          },
          {
            "arabic": "وِجْهك طَويل؟ لا، حِلو!",
            "latin": "wíjhak ʈawīl? laʔ, ɧílu!",
            "english": "Your face long? No, handsome!"
          },
          {
            "arabic": "شو بْتِشوف؟ أنا بْشوف أحْمر وأزْرق.",
            "latin": "šū bitšūf? ána bašūf áɧmar w ázrag.",
            "english": "What do you see? I see red and blue."
          },
          {
            "arabic": "هالرّاس راسك، وهالقلْب قلْبك.",
            "latin": "harrās rāsak, w halgalb gálbak.",
            "english": "This head is your head, and this heart is your heart."
          }
        ]
      }
    },
    {
      "id": "tale:road:9",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 8,
        "regular": "road:9",
        "title": "Hassan bargains",
        "lines": [
          {
            "arabic": "هالكيس بِعشرة شيْكِل.",
            "latin": "halkīs b-3ášara šēkil.",
            "english": "This bag is ten shekels."
          },
          {
            "arabic": "غالي؟ لا، رْخيص!",
            "latin": "ɣāli? laʔ, rxīʂ!",
            "english": "Expensive? No, cheap!"
          },
          {
            "arabic": "قدّيْش بِدّك تِدْفع؟",
            "latin": "gaddēš bíddak tídfa3?",
            "english": "How much do you want to pay?"
          },
          {
            "arabic": "خمْسة؟ لا، سبْعة.",
            "latin": "xámsa? laʔ, sáb3a.",
            "english": "Five? No, seven."
          },
          {
            "arabic": "طيِّب، سِتّة، والشّاي مِنّي.",
            "latin": "ʈáyyib, sítta, w iššāy mínni.",
            "english": "Okay, six, and the tea is on me."
          }
        ]
      }
    },
    {
      "id": "tale:road:10",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 9,
        "regular": "road:10",
        "title": "Miss Huda’s class",
        "lines": [
          {
            "arabic": "أنا أُسْتاذة في المدْرسة.",
            "latin": "ána ustāza fi lmádrasa.",
            "english": "I’m a teacher at the school."
          },
          {
            "arabic": "الدّرْس بِبْدا بدْري، السّاعة تمانْيَة.",
            "latin": "iddars bíbda bádri, issā3a tamānya.",
            "english": "The lesson begins early, at eight."
          },
          {
            "arabic": "الطُّلّاب بْيِسْألوا، وأنا بْقول الجَواب.",
            "latin": "iʈʈullāb byisʔalu, w ána bagūl ijjawāb.",
            "english": "The students ask, and I give the answer."
          },
          {
            "arabic": "الجَواب صحّ؟ غلط؟ بِنِتْعلّم.",
            "latin": "ijjawāb ʂaɧɧ? ɣálaʈ? binit3állam.",
            "english": "Is the answer right? Wrong? We learn."
          },
          {
            "arabic": "وبعديْن بقْرا كْتاب.",
            "latin": "w ba3dēn bágra ktāb.",
            "english": "And later I read a book."
          }
        ]
      }
    },
    {
      "id": "tale:road:11",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 10,
        "regular": "road:11",
        "title": "Jamil’s weather",
        "lines": [
          {
            "arabic": "اليوْم الشّمِس حِلْوة.",
            "latin": "ilyōm iššámis ɧílwa.",
            "english": "Today the sun is nice."
          },
          {
            "arabic": "بسّ الهَوا ساقِع، وفي غيْمة.",
            "latin": "bass ilháwa sāgi3, w fi ɣēma.",
            "english": "But the wind is cold, and there’s a cloud."
          },
          {
            "arabic": "أنا تعْبان، بسّ مبْسوط.",
            "latin": "ána ta3bān, bass mabsūʈ.",
            "english": "I’m tired, but happy."
          },
          {
            "arabic": "ليْش؟ عشان القلْب دايْماً بِحِبّ الشِّتا.",
            "latin": "lēš? 3ašān ilgalb dāyman biɧíbb iššíta.",
            "english": "Why? Because the heart always loves the rain."
          },
          {
            "arabic": "اُقْعُد معي، واِسْمع.",
            "latin": "úg3ud má3i, w ísma3.",
            "english": "Sit with me, and listen."
          }
        ]
      }
    },
    {
      "id": "tale:road:12",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 11,
        "regular": "road:12",
        "title": "Samira measures you",
        "lines": [
          {
            "arabic": "هالبالْطو حِلو، بسّ وِسِخ.",
            "latin": "halbālʈō ɧílu, bass wísix.",
            "english": "This coat is nice, but dirty."
          },
          {
            "arabic": "اِشْلح البالْطو! بغْسْلو اليوْم.",
            "latin": "íšlaɧ ilbālʈō! baɣsílu ilyōm.",
            "english": "Take off the coat! I’ll wash it today."
          },
          {
            "arabic": "وهالقميص؟ لوْنو بِنّي غامِق.",
            "latin": "w halgamīʂ? lōnu bínni ɣāmig.",
            "english": "And this shirt? Its color is dark brown."
          },
          {
            "arabic": "بِدّك واحد أزْرق فاتِح؟",
            "latin": "bíddak wāɧad ázrag fātiɧ?",
            "english": "Do you want a light blue one?"
          },
          {
            "arabic": "مع لفْحة زهْري، إنْتَ مْرتّب كْتير!",
            "latin": "ma3 láfɧa záhri, ínta mráttab ktīr!",
            "english": "With a pink scarf, you look very sharp!"
          }
        ]
      }
    },
    {
      "id": "tale:road:13",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 12,
        "regular": "road:13",
        "title": "Abu Sami’s family",
        "lines": [
          {
            "arabic": "هالشّابّ اِبْني، وهالمرا مرْتو.",
            "latin": "haššabb íbni, w halmára mártu.",
            "english": "This young man is my son, and this woman is his wife."
          },
          {
            "arabic": "والرّضيع؟ هُوَّ اِبِن بِنْتي.",
            "latin": "w irraɖī3? húwwa ibn bínti.",
            "english": "And the baby? He’s my daughter’s son."
          },
          {
            "arabic": "عمّو وخالْتو هِناك، مع الْوْلاد.",
            "latin": "3ámmu w xáltu hināk, ma3 ilwlād.",
            "english": "His uncle and his aunt are over there, with the kids."
          },
          {
            "arabic": "أنا عجوز، وبنْسى الأسامي.",
            "latin": "ána 3ajūz, w bánsa ilʔasāmi.",
            "english": "I’m an old man, and I forget the names."
          },
          {
            "arabic": "بسّ بتْزكّر كُلّ وِجِهْ.",
            "latin": "bass badzákkar kull wíjih.",
            "english": "But I remember every face."
          }
        ]
      }
    },
    {
      "id": "tale:road:14",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 13,
        "regular": "road:14",
        "title": "Karim takes your order",
        "lines": [
          {
            "arabic": "شو بِدّك تِفْطر؟",
            "latin": "šū bíddak tífʈar?",
            "english": "What do you want for breakfast?"
          },
          {
            "arabic": "في خُبِز وزِبْدة ولبن وعصير بُرْتْقان.",
            "latin": "fi xúbiz w zíbda w lában w 3aʂīr burtgān.",
            "english": "There’s bread, butter, yogurt and orange juice."
          },
          {
            "arabic": "وقهْوة؟ سادة، أوْ مع سُكّر؟",
            "latin": "w gáhwa? sāda, aw ma3 súkkar?",
            "english": "And coffee? Plain, or with sugar?"
          },
          {
            "arabic": "طيِّب، بجيب القهْوة.",
            "latin": "ʈáyyib, bajīb ilgáhwa.",
            "english": "Okay, I’ll bring the coffee."
          },
          {
            "arabic": "والعشا؟ معْكروْنة مع بنْدوْرة وبصل. لزيز!",
            "latin": "w il3áša? ma3karōna ma3 bandōra w báʂal. lazīz!",
            "english": "And dinner? Pasta with tomatoes and onions. Tasty!"
          }
        ]
      }
    },
    {
      "id": "tale:road:15",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 14,
        "regular": "road:15",
        "title": "Mona’s empty house",
        "lines": [
          {
            "arabic": "هالبيْت فيه حيْطان وأرْض، وبسّ.",
            "latin": "halbēt fī ɧēʈān w arɖ, w bass.",
            "english": "This house has walls and a floor, and that’s all."
          },
          {
            "arabic": "بِدّي لمْبة ومْرايَة ومْخدّة.",
            "latin": "bíddi lámba w mrāya w mxádda.",
            "english": "I want a lamp, a mirror and a pillow."
          },
          {
            "arabic": "والصّورة؟ على الحيْط، فوْق الكنبة.",
            "latin": "w iʂʂūra? 3ála lɧēʈ, fōg ilkánaba.",
            "english": "And the picture? On the wall, over the sofa."
          },
          {
            "arabic": "بفْتح الشُّبّاك، وبعمل قهْوة.",
            "latin": "báftaɧ iššubbāk, w bá3mal gáhwa.",
            "english": "I open the window, and make coffee."
          },
          {
            "arabic": "واليوْم، هالبيْت بيْتي.",
            "latin": "w ilyōm, halbēt bēti.",
            "english": "And today, this house is my home."
          }
        ]
      }
    },
    {
      "id": "tale:road:16",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 15,
        "regular": "road:16",
        "title": "Tariq studies",
        "lines": [
          {
            "arabic": "بُكْرا عِنْدي اِمْتِحان.",
            "latin": "búkra 3índi imtiɧān.",
            "english": "Tomorrow I have a test."
          },
          {
            "arabic": "بدْرُس إنْجْليزي وفرنْسي، وألْماني كمان.",
            "latin": "bádrus inglīzi w faránsi, w almāni kamān.",
            "english": "I study English and French, and German too."
          },
          {
            "arabic": "بسّ العربي صِعِب!",
            "latin": "bass il3árabi ʂí3ib!",
            "english": "But Arabic is hard!"
          },
          {
            "arabic": "بكْتِب كُلّ كِلْمة في الدّفْتر.",
            "latin": "báktib kull kílma fi ddáftar.",
            "english": "I write every word in the notebook."
          },
          {
            "arabic": "إذا ما بفْهمْش، بسْأل الأُسْتاذ.",
            "latin": "íza ma bafhámiš, basʔal ilʔustāz.",
            "english": "If I don’t understand, I ask the teacher."
          }
        ]
      }
    },
    {
      "id": "tale:road:17",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 16,
        "regular": "road:17",
        "title": "Dalia’s bag",
        "lines": [
          {
            "arabic": "معي جرايِد ومجلّات وظْروف.",
            "latin": "má3i jarāyid w majallāt w ʐrūf.",
            "english": "I’ve got newspapers, magazines and envelopes."
          },
          {
            "arabic": "شو عِنْوان هالظّرْف؟",
            "latin": "šū 3inwān haʐʐarf?",
            "english": "What’s the address on this envelope?"
          },
          {
            "arabic": "اليوْم الكُلّ بِبْعت إيميْل.",
            "latin": "ilyōm ilkull bíb3at īmēl.",
            "english": "Today everyone sends an email."
          },
          {
            "arabic": "بسّ الجوّال دايْماً مشْغول، والنِّت فيه مشاكِل.",
            "latin": "bass ijjawwāl dāyman mašɣūl, w innit fī mašākil.",
            "english": "But the phone is always busy, and the internet has problems."
          },
          {
            "arabic": "والبريد؟ البريد دايْماً بوْصل.",
            "latin": "w ilbarīd? ilbarīd dāyman byūʂal.",
            "english": "And the mail? The mail always arrives."
          }
        ]
      }
    },
    {
      "id": "tale:road:18",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 17,
        "regular": "road:18",
        "title": "Fares by the fire",
        "lines": [
          {
            "arabic": "بِالعادة، المسا، بغنّي وبلْعب غيتار.",
            "latin": "bi-l3āda, ilmása, baɣánni w bál3ab gītār.",
            "english": "Usually, in the evening, I sing and play the guitar."
          },
          {
            "arabic": "الشّباب بْيُرْقُصوا، والْوْلاد بْيِلْعبوا.",
            "latin": "iššabāb byúrguʂu, w ilwlād byil3abu.",
            "english": "The young men dance, and the kids play."
          },
          {
            "arabic": "وإنْتَ؟ شو هِوايْتك؟",
            "latin": "w ínta? šū hiwāytak?",
            "english": "And you? What’s your hobby?"
          },
          {
            "arabic": "كوْرة؟ تِنْس؟ بْتِسْبح؟",
            "latin": "kōra? tins? btísbaɧ?",
            "english": "Soccer? Tennis? Do you swim?"
          },
          {
            "arabic": "بلِّش، غنّي معي!",
            "latin": "bálliš, ɣánni má3i!",
            "english": "Go on, sing with me!"
          }
        ]
      }
    },
    {
      "id": "tale:road:19",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 18,
        "regular": "road:19",
        "title": "Amal knows the way",
        "lines": [
          {
            "arabic": "ويْن بِدّك تْروح؟",
            "latin": "wēn bíddak trūɧ?",
            "english": "Where do you want to go?"
          },
          {
            "arabic": "عمّان؟ عاصِمة الأُرْدُن.",
            "latin": "3ammān? 3āʂimt ilʔúrdun.",
            "english": "Amman? The capital of Jordan."
          },
          {
            "arabic": "الباص بِطْلع الصُّبِح، السّاعة سِتّة.",
            "latin": "ilbāʂ bíʈla3 iʂʂúbiɧ, issā3a sítta.",
            "english": "The bus sets off in the morning, at six."
          },
          {
            "arabic": "بِدّك تِكِت؟ وفيزا؟",
            "latin": "bíddak tíkit? w vīza?",
            "english": "You need a ticket? And a visa?"
          },
          {
            "arabic": "طيِّب، إجازة حِلْوة!",
            "latin": "ʈáyyib, ijāza ɧílwa!",
            "english": "Okay, have a nice vacation!"
          }
        ]
      }
    },
    {
      "id": "tale:road:20",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 19,
        "regular": "road:20",
        "title": "Ziad’s mountain",
        "lines": [
          {
            "arabic": "بُكْرا الصُّبِح، بِنْروح على الجبل.",
            "latin": "búkra iʂʂúbiɧ, binrūɧ 3ála ljábal.",
            "english": "Tomorrow morning, we go up the mountain."
          },
          {
            "arabic": "هِناك في عنْزة، وحْمار، وكلْب.",
            "latin": "hināk fi 3ánza, w ɧmār, w kalb.",
            "english": "Up there there’s a goat, a donkey and a dog."
          },
          {
            "arabic": "الكلْب سريع، والحْمار بطيء.",
            "latin": "ilkalb sarī3, w ilɧmār baʈīʔ.",
            "english": "The dog is fast, and the donkey is slow."
          },
          {
            "arabic": "وتحِت الجبل في بُحَيْرة وشجرة كْبيرة.",
            "latin": "w táɧt ijjábal fi buɧēra w šájara kbīra.",
            "english": "And under the mountain there’s a lake and a big tree."
          },
          {
            "arabic": "المسا، بِنْشوف القمر والنِّجْمات.",
            "latin": "ilmása, binšūf ilgámar w innijmāt.",
            "english": "In the evening, we see the moon and the stars."
          }
        ]
      }
    },
    {
      "id": "tale:road:21",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 20,
        "regular": "road:21",
        "title": "Abu Nabil’s sums",
        "lines": [
          {
            "arabic": "عِنْدي ألْف كيس.",
            "latin": "3índi alf kīs.",
            "english": "I have a thousand sacks."
          },
          {
            "arabic": "الأحد بِعْت خمْسين، والِاتْنيْن سِتّين.",
            "latin": "ilʔáɧad bi3t xamsīn, w litnēn sittīn.",
            "english": "On Sunday I sold fifty, and on Monday sixty."
          },
          {
            "arabic": "التّلات؟ صِفِر!",
            "latin": "ittalāt? ʂífir!",
            "english": "Tuesday? Zero!"
          },
          {
            "arabic": "قدّيْش عِنْدي اليوْم؟",
            "latin": "gaddēš 3índi ilyōm?",
            "english": "How many do I have today?"
          },
          {
            "arabic": "تمن مية وتِسْعين! صحّ؟",
            "latin": "táman míyya w tis3īn! ʂaɧɧ?",
            "english": "Eight hundred and ninety! Right?"
          }
        ]
      }
    },
    {
      "id": "tale:road:22",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 21,
        "regular": "road:22",
        "title": "Khalid’s cousins",
        "lines": [
          {
            "arabic": "أنا بسافِر كْتير.",
            "latin": "ána bsāfir ktīr.",
            "english": "I travel a lot."
          },
          {
            "arabic": "اِبِن عمّي في سورِيا، وخالي في العِراق.",
            "latin": "ibn 3ámmi fi sūriya, w xāli fi l3irāq.",
            "english": "My cousin is in Syria, and my uncle is in Iraq."
          },
          {
            "arabic": "ومرْتي مغْرِبية، مِن المغْرِب.",
            "latin": "w márti maɣribíyya, min ilmáɣrib.",
            "english": "And my wife is Moroccan, from Morocco."
          },
          {
            "arabic": "الصّيْف في السُّعودية سُخُن كْتير.",
            "latin": "iʂʂēf fi ssu3ūdíyya súxun ktīr.",
            "english": "Summer in Saudi Arabia is very hot."
          },
          {
            "arabic": "بسّ أنا بحِبّ اليَمن وعُمان.",
            "latin": "bass ána baɧíbb ilyáman w 3umān.",
            "english": "But I love Yemen and Oman."
          }
        ]
      }
    },
    {
      "id": "tale:road:23",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 22,
        "regular": "road:23",
        "title": "Captain Elias’s ports",
        "lines": [
          {
            "arabic": "أنا رُحِت على كُلّ أوْروْبّا.",
            "latin": "ána rúɧit 3ála kull ōrōbba.",
            "english": "I’ve been all over Europe."
          },
          {
            "arabic": "فرنْسا، أسْبانْيا، إيطالْيا، وهوْلانْدا.",
            "latin": "faránsa, asbānya, īʈālya, w hōlānda.",
            "english": "France, Spain, Italy and the Netherlands."
          },
          {
            "arabic": "في النّرْويج البحر ساقِع كْتير.",
            "latin": "fi nnarwīj ilbáɧar sāgi3 ktīr.",
            "english": "In Norway the sea is very cold."
          },
          {
            "arabic": "وفي البُرْتُغال السّمك زاكي!",
            "latin": "w fi lburtuɣāl issámak zāki!",
            "english": "And in Portugal the fish is delicious!"
          },
          {
            "arabic": "بسّ بيْتي هان، جنْب البحر.",
            "latin": "bass bēti hān, jamb ilbáɧar.",
            "english": "But my home is here, by the sea."
          }
        ]
      }
    },
    {
      "id": "tale:road:24",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 23,
        "regular": "road:24",
        "title": "Mei’s markets",
        "lines": [
          {
            "arabic": "أنا مِن تايْوان.",
            "latin": "ána min tāywān.",
            "english": "I’m from Taiwan."
          },
          {
            "arabic": "شُفِت أسْواق في الهِنْد والصّين واليابان.",
            "latin": "šúfit aswāg fi lhínd w iʂʂīn w ilyābān.",
            "english": "I’ve seen markets in India, China and Japan."
          },
          {
            "arabic": "وفي تُرْكْيا وإيران كمان.",
            "latin": "w fi túrkya w īrān kamān.",
            "english": "And in Turkey and Iran too."
          },
          {
            "arabic": "بسّ العربي؟ بتْعلّمو هان، كِلْمة كِلْمة.",
            "latin": "bass il3árabi? bat3allámu hān, kílma kílma.",
            "english": "But Arabic? I’m learning it here, word by word."
          },
          {
            "arabic": "والكاميرا دايْماً معي.",
            "latin": "w ilkāmira dāyman má3i.",
            "english": "And the camera is always with me."
          }
        ]
      }
    },
    {
      "id": "tale:road:25",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 24,
        "regular": "road:25",
        "title": "Rami measures the road",
        "lines": [
          {
            "arabic": "اليوْم مشيْت خمسْتلاف مِتِر.",
            "latin": "ilyōm mašēt xamastalāf mitir.",
            "english": "Today I walked five thousand meters."
          },
          {
            "arabic": "خمِس كيْلوْمِتِر!",
            "latin": "xámas kēlōmitir!",
            "english": "Five kilometers!"
          },
          {
            "arabic": "بُكْرا كمان سِتّلاف.",
            "latin": "búkra kamān sittalāf.",
            "english": "Tomorrow, six thousand more."
          },
          {
            "arabic": "وفي آخِر أيْلول؟ أنا في البيْت مع الْوْلاد!",
            "latin": "w fi āxir aylūl? ána fi lbēt ma3 ilwlād!",
            "english": "And at the end of September? I’m home with the kids!"
          }
        ]
      }
    },
    {
      "id": "tale:road:26",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 25,
        "regular": "road:26",
        "title": "Nour’s cart",
        "lines": [
          {
            "arabic": "هالجاكيْتّ: سْموْل، ميدْيَم، أوْ لارْج؟",
            "latin": "haljākētt: smōl, mīdyam, aw lārj?",
            "english": "This jacket: small, medium or large?"
          },
          {
            "arabic": "سِعْرو؟ تلاتين شيْكِل بسّ.",
            "latin": "sí3ru? talātīn šēkil bass.",
            "english": "Its price? Just thirty shekels."
          },
          {
            "arabic": "بِتِدْفع كاش، أوْ بِالبِطاقة؟",
            "latin": "bitídfa3 kāš, aw bi-lbiʈāqa?",
            "english": "Are you paying cash, or by card?"
          },
          {
            "arabic": "والشُّرْط؟ صْغير عليك شْوَيّ.",
            "latin": "w iššurt? ʂɣīr 3alēk šwayy.",
            "english": "And the shorts? A bit small on you."
          },
          {
            "arabic": "الكبوْي حِلو عليك!",
            "latin": "ilkabōy ɧílu 3alēk!",
            "english": "The jeans look good on you!"
          }
        ]
      }
    },
    {
      "id": "tale:road:27",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 26,
        "regular": "road:27",
        "title": "Doctor Nadia’s visit",
        "lines": [
          {
            "arabic": "اِفْتح تِمّك!",
            "latin": "íftaɧ tímmak!",
            "english": "Open your mouth!"
          },
          {
            "arabic": "راسك أجعك؟",
            "latin": "rāsak ʔája3ak?",
            "english": "Does your head hurt?"
          },
          {
            "arabic": "إنْتَ مريض شْوَيّ.",
            "latin": "ínta marīɖ šwayy.",
            "english": "You’re a little sick."
          },
          {
            "arabic": "بْتاخُد الدَّوا الصُّبِح والمسا.",
            "latin": "btāxud iddáwa iʂʂúbiɧ w ilmása.",
            "english": "You take the medicine morning and evening."
          },
          {
            "arabic": "ونام كْتير، واِشْرب ميّة.",
            "latin": "w nām ktīr, w íšrab máyya.",
            "english": "And sleep a lot, and drink water."
          }
        ]
      }
    },
    {
      "id": "tale:road:28",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 27,
        "regular": "road:28",
        "title": "Uncle Antoine comes home",
        "lines": [
          {
            "arabic": "أنا بعيش في البرازيل مِن أرْبْعين سنة.",
            "latin": "ána ba3īš fi lbarāzīl min arb3īn sána.",
            "english": "I’ve lived in Brazil for forty years."
          },
          {
            "arabic": "هِناك الموسيقى والرّقْصة في كُلّ شارِع.",
            "latin": "hināk ilmūsīqa w irrágʂa fi kull šāri3.",
            "english": "There, there’s music and dancing on every street."
          },
          {
            "arabic": "بسّ بيْتي هان، في فلسْطين.",
            "latin": "bass bēti hān, fi falasʈīn.",
            "english": "But my home is here, in Palestine."
          },
          {
            "arabic": "سِلْفي؟ اِبْتسم!",
            "latin": "sílfi? ibtísim!",
            "english": "A selfie? Smile!"
          }
        ]
      }
    },
    {
      "id": "tale:road:29",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 28,
        "regular": "road:29",
        "title": "Salim’s other words",
        "lines": [
          {
            "arabic": "مرْحبا! كيْفك؟ كْوَيِّس؟",
            "latin": "márɧaba! kēfak? kwáyyis?",
            "english": "Hi! How are you? Good?"
          },
          {
            "arabic": "أنا كمان تمام.",
            "latin": "ána kamān tamām.",
            "english": "I’m fine too."
          },
          {
            "arabic": "في مصِر بِقولوا «ليْه»، وهِنا بِنْقول «ليْش».",
            "latin": "fi máʂir bigūlu «lē», w hína bingūl «lēš».",
            "english": "In Egypt they say “lē”, and here we say “lēš”."
          },
          {
            "arabic": "وبِقولوا «كْوَيِّس»، وإحْنا بِنْقول «مْنيح».",
            "latin": "w bigūlu «kwáyyis», w íɧna bingūl «mnīɧ».",
            "english": "And they say “kwáyyis”, and we say “mnīɧ”."
          },
          {
            "arabic": "أظُنّ إنّو الكُلّ بِفْهم الكُلّ.",
            "latin": "aʐúnn ínnu ilkull bífham ilkull.",
            "english": "I think everyone understands everyone."
          }
        ]
      }
    },
    {
      "id": "tale:road:30",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 29,
        "regular": "road:30",
        "title": "Abu Hani’s chair",
        "lines": [
          {
            "arabic": "اُقْعُد! بِدّك أحْلِق دقْنك؟",
            "latin": "úg3ud! bíddak áɧlig dágnak?",
            "english": "Sit! Want me to shave your beard?"
          },
          {
            "arabic": "لا؟ طيِّب، بسّ الشّنب.",
            "latin": "laʔ? ʈáyyib, bass iššánab.",
            "english": "No? Okay, just the mustache."
          },
          {
            "arabic": "إنْتَ نعْسان؟ اِتْنفّس، وغفّي شْوَيّ.",
            "latin": "ínta na3sān? itnáffas, w ɣáffi šwayy.",
            "english": "You’re sleepy? Breathe, and nap a little."
          },
          {
            "arabic": "بعديْن بْتِصْحى حِلو!",
            "latin": "ba3dēn btíʂɧa ɧílu!",
            "english": "Then you wake up handsome!"
          }
        ]
      }
    },
    {
      "id": "tale:road:31",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 30,
        "regular": "road:31",
        "title": "Umm Ali’s soup",
        "lines": [
          {
            "arabic": "دوق هالشّوْربة!",
            "latin": "dūg haššōraba!",
            "english": "Taste this soup!"
          },
          {
            "arabic": "مالْحة؟ حرّاقة؟",
            "latin": "mālɧa? ɧarrāga?",
            "english": "Salty? Spicy?"
          },
          {
            "arabic": "فيها توْمة وحُمُّص وشْوَيِّةْ خلّ.",
            "latin": "fīha tōma w ɧúmmuʂ w šwáyyit xall.",
            "english": "It has garlic, chickpeas and a little vinegar."
          },
          {
            "arabic": "والفلافِل طازة ومقْلي.",
            "latin": "w ilfalāfil ʈāza w mágli.",
            "english": "And the falafel is fresh and fried."
          },
          {
            "arabic": "كُل! إنْتَ جعان، وأنا مبْسوطة.",
            "latin": "kul! ínta ja3ān, w ána mabsūʈa.",
            "english": "Eat! You’re hungry, and I’m happy."
          }
        ]
      }
    },
    {
      "id": "tale:road:32",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 31,
        "regular": "road:32",
        "title": "Abu Fadi’s house",
        "lines": [
          {
            "arabic": "هالبيْت فيه بُدْرُم، الأرْضي، وتلات طَوابِق.",
            "latin": "halbēt fīh búdrum, ilʔárɖi, w tlat ʈawābiq.",
            "english": "This house has a basement, the ground floor and three floors."
          },
          {
            "arabic": "في أصانْصيْر، بسّ إبْني بِحِبّ الدّرج.",
            "latin": "fī aʂanʂēr, bass íbni bíɧibb iddáraj.",
            "english": "There’s an elevator, but my son loves the stairs."
          },
          {
            "arabic": "وفوْق في سُطُح، وبْنِشْرب قهْوة هْناك.",
            "latin": "w fōg fī súʈuɧ, w bníšrab gáhwa hnāk.",
            "english": "And up top there’s a roof, and we drink coffee there."
          },
          {
            "arabic": "الأجار؟ لا، بيْتْنا!",
            "latin": "ilʔajār? laʔ, bétna!",
            "english": "The rent? No, it’s our own house!"
          }
        ]
      }
    },
    {
      "id": "tale:road:33",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 32,
        "regular": "road:33",
        "title": "Wafa’s list",
        "lines": [
          {
            "arabic": "شو وَظيفْتك؟ مُهنْدِس؟ ميْكانيكي؟",
            "latin": "šu waʐíftak? muhándis? mekanīki?",
            "english": "What’s your job? Engineer? Mechanic?"
          },
          {
            "arabic": "الدَّوام طويل، بسّ في بْريْك.",
            "latin": "iddawām ʈawīl, bass fī brēk.",
            "english": "The hours are long, but there’s a break."
          },
          {
            "arabic": "الرّاتِب مْنيح، وبْتُقْبُض كُلّ شهِر.",
            "latin": "irrātib mnīɧ, w btúgbuʂ kull šáhir.",
            "english": "The salary is good, and you get paid every month."
          },
          {
            "arabic": "مُديرك؟ أنا! أهلا بالشِّرْكة.",
            "latin": "mudīrak? ána! áhla biššírka.",
            "english": "Your boss? Me! Welcome to the company."
          }
        ]
      }
    },
    {
      "id": "tale:road:34",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 33,
        "regular": "road:34",
        "title": "Amal’s road",
        "lines": [
          {
            "arabic": "اِرْكب، ما في زحْمة اليوْم.",
            "latin": "írkab, ma fī záɧma ilyōm.",
            "english": "Get on, there’s no traffic today."
          },
          {
            "arabic": "شوف الجِسِر، وشوف الميدان.",
            "latin": "šūf ijjísir, w šūf ilmaydān.",
            "english": "Look at the bridge, and look at the square."
          },
          {
            "arabic": "بعديْن الحْدود، والسّفينة، وبرّا!",
            "latin": "ba3dēn ilɧdūd, w issafīna, w bárra!",
            "english": "Then the border, the ship, and abroad!"
          },
          {
            "arabic": "وإنْتَ؟ بْتِرْكب بْبلاش!",
            "latin": "w ínta? btírkab bbalāš!",
            "english": "And you? You ride for free!"
          }
        ]
      }
    },
    {
      "id": "tale:road:35",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 34,
        "regular": "road:35",
        "title": "The innkeeper’s story",
        "lines": [
          {
            "arabic": "زمان، كُنْت خجولة كْتير.",
            "latin": "zamān, kunt xajūla ktīr.",
            "english": "Long ago, I was very shy."
          },
          {
            "arabic": "بعديْن قرّرْت أشْتِغِل هِنا.",
            "latin": "ba3dēn garrárt aštíɣil hína.",
            "english": "Then I decided to work here."
          },
          {
            "arabic": "الشُّغُل صعب، بسّ بسْتمْتِع فيه.",
            "latin": "iššúɣul ʂa3b, bass bastámti3 fīh.",
            "english": "The work is hard, but I enjoy it."
          },
          {
            "arabic": "وإنْتَ؟ شو بِتْتمنّى؟",
            "latin": "w ínta? šu btitmánna?",
            "english": "And you? What do you hope for?"
          }
        ]
      }
    },
    {
      "id": "tale:road:36",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 35,
        "regular": "road:36",
        "title": "Hana’s wedding",
        "lines": [
          {
            "arabic": "العُرُس بُكْرة! وأنا العروس.",
            "latin": "il3úrus búkra! w ána il3arūs.",
            "english": "The wedding is tomorrow! And I’m the bride."
          },
          {
            "arabic": "العريس إسْمو فادي.",
            "latin": "il3arīs ísmu fādi.",
            "english": "The groom’s name is Fadi."
          },
          {
            "arabic": "كُلّ القرايِب هِنا.",
            "latin": "kull ilgarāyib hína.",
            "english": "All the relatives are here."
          },
          {
            "arabic": "شوف المحْبس! حِلو؟",
            "latin": "šūf ilmáɧbas! ɧílu?",
            "english": "Look at the ring! Pretty?"
          }
        ]
      }
    },
    {
      "id": "tale:road:37",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 36,
        "regular": "road:37",
        "title": "Samira’s trunk",
        "lines": [
          {
            "arabic": "شوف! حرير، وقُطُن، وصوف.",
            "latin": "šūf! ɧarīr, w gúʈun, w ʂūf.",
            "english": "Look! Silk, cotton and wool."
          },
          {
            "arabic": "البدْلة ضِيِّقة؟ لا، واسْعة شْوَيّ.",
            "latin": "ilbádla ɖáyyga? laʔ, wás3a šwayy.",
            "english": "Is the suit tight? No, a little loose."
          },
          {
            "arabic": "وهالخاتِم دهب، وهالسِّنْسال فِضّة.",
            "latin": "w halxātim dáhab, w hassinsāl fíɖɖa.",
            "english": "And this ring is gold, and this necklace is silver."
          },
          {
            "arabic": "اِلْبِس! إنْتَ حِلو.",
            "latin": "ílbis! ínta ɧílu.",
            "english": "Put it on! You look good."
          }
        ]
      }
    },
    {
      "id": "tale:road:38",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 37,
        "regular": "road:38",
        "title": "Yousef’s pains",
        "lines": [
          {
            "arabic": "آخ، ضهْري! وعِنْدي قحّة.",
            "latin": "āx, ɖáhri! w 3índi gáɧɧa.",
            "english": "Ouch, my back! And I have a cough."
          },
          {
            "arabic": "وحرارْتي عالْيَة.",
            "latin": "w ɧarárti 3álya.",
            "english": "And I have a fever."
          },
          {
            "arabic": "بدّي أسْبيرين، مِش رُجيم!",
            "latin": "bíddi asbirīn, miš rujīm!",
            "english": "I want aspirin, not a diet!"
          },
          {
            "arabic": "بسّ صِحّتي مْنيحة!",
            "latin": "bass ʂíɧɧti mnīɧa!",
            "english": "But my health is good!"
          }
        ]
      }
    },
    {
      "id": "tale:road:39",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 38,
        "regular": "road:39",
        "title": "Lina’s trays",
        "lines": [
          {
            "arabic": "جعان؟ خُد فْطيرة!",
            "latin": "ja3ān? xud fʈīra!",
            "english": "Hungry? Take a pie!"
          },
          {
            "arabic": "والبسْكوْت بِالفانيلّا.",
            "latin": "w ilbaskōt bilvanílla.",
            "english": "And the cookies are vanilla."
          },
          {
            "arabic": "في إسْبْرِسّو، وَسط.",
            "latin": "fī esprésso, wásaʈ.",
            "english": "There’s espresso, medium-sweet."
          },
          {
            "arabic": "كُل! بعديْن بْتِشْبع.",
            "latin": "kul! ba3dēn btíšba3.",
            "english": "Eat! Then you’ll be full."
          }
        ]
      }
    },
    {
      "id": "tale:road:40",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 39,
        "regular": "road:40",
        "title": "Abu Saleh’s cart",
        "lines": [
          {
            "arabic": "كُلّو مِن مزْرعْتي: مِشْمِش، وكرز، وخوْخ.",
            "latin": "kúllu min mazrá3ti: míšmiš, w káraz, w xōx.",
            "english": "All from my farm: apricots, cherries and plums."
          },
          {
            "arabic": "وفي الحقِل، قمِح ودُرة.",
            "latin": "w fi ilɧáqil, gámiɧ w dúra.",
            "english": "And in the field, wheat and corn."
          },
          {
            "arabic": "والنّحِل تحت النّخْلة.",
            "latin": "w innáɧil taɧt innáxla.",
            "english": "And the bees are under the palm tree."
          },
          {
            "arabic": "دوق! حِلو، مِش هيك؟",
            "latin": "dūg! ɧílu, miš hēk?",
            "english": "Taste! Sweet, isn’t it?"
          }
        ]
      }
    },
    {
      "id": "tale:road:41",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 40,
        "regular": "road:41",
        "title": "Tariq’s tools",
        "lines": [
          {
            "arabic": "السّور؟ بْبْنيه مِن خشب.",
            "latin": "issūr? bábnī min xášab.",
            "english": "The fence? I’ll build it out of wood."
          },
          {
            "arabic": "والشّبابيك؟ قْزاز جْديد.",
            "latin": "w iššabābīk? gzāz jdīd.",
            "english": "And the windows? New glass."
          },
          {
            "arabic": "الشّمْعة حرقت الطّاوْلة!",
            "latin": "iššám3a ɧárgat iʈʈāwla!",
            "english": "The candle burned the table!"
          },
          {
            "arabic": "جهّزْت كُلّو!",
            "latin": "jahházt kúllu!",
            "english": "I’ve got it all ready!"
          }
        ]
      }
    }
  ]
}
