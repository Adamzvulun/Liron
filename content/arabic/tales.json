{
  "subject": "arabic",
  "source": "waymark",
  "license": "Our own: tales written by us from the words each chapter teaches, checked against the deck (ADR 0012)",
  "items": [
    {
      "id": "tale:road:2",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 1,
        "regular": "road:2",
        "title": "Salim at the gate",
        "lines": [
          {
            "arabic": "مرْحبا! صباح الخيْر!",
            "latin": "márɧaba! ʂabāɧ ilxēr!",
            "english": "Hi! Good morning!"
          },
          {
            "arabic": "أنا سليم. أهْلا وسهْلا! وإنْتَ؟",
            "latin": "ána salīm. áhla w sáhla! w ínta?",
            "english": "I’m Salim. Welcome! And you?"
          },
          {
            "arabic": "أنا بْخيْر، شُكْراً.",
            "latin": "ána b-xēr, šúkran.",
            "english": "I’m fine, thanks."
          },
          {
            "arabic": "هالوَلد وهالبِنِت؟ طيِّب، أهْلا!",
            "latin": "halwálad w halbínit? ʈáyyib, áhla!",
            "english": "This boy and this girl? Okay, welcome!"
          },
          {
            "arabic": "تْفضّل! … باي، باي!",
            "latin": "tfáɖɖal! … bāy, bāy!",
            "english": "Here you are! … Bye, bye!"
          }
        ]
      }
    },
    {
      "id": "tale:road:3",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 2,
        "regular": "road:3",
        "title": "Umm Khalil asks",
        "lines": [
          {
            "arabic": "مين إنْتَ؟ ومِن ويْن؟",
            "latin": "mīn ínta? w min wēn?",
            "english": "Who are you? And where from?"
          },
          {
            "arabic": "أنا أمّ خليل.",
            "latin": "ána umm xalīl.",
            "english": "I’m Umm Khalil."
          },
          {
            "arabic": "خليل اِبْني، وهُوَّ مِتْجوِّز.",
            "latin": "xalīl íbni, w húwwa midjáwwiz.",
            "english": "Khalil is my son, and he’s married."
          },
          {
            "arabic": "وبِنْتو هان، معي.",
            "latin": "w bíntu hān, má3i.",
            "english": "And his daughter is here, with me."
          },
          {
            "arabic": "وإنْتَ؟ مِتْجوِّز؟ لا؟ ليْش؟!",
            "latin": "w ínta? midjáwwiz? laʔ? lēš?!",
            "english": "And you? Married? No? Why?!"
          }
        ]
      }
    },
    {
      "id": "tale:road:4",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 3,
        "regular": "road:4",
        "title": "Yusuf keeps time",
        "lines": [
          {
            "arabic": "أنا يوسف. اليوْم الجُّمْعة.",
            "latin": "ána yūsif. ilyōm ijjúm3a.",
            "english": "I’m Yusuf. Today is Friday."
          },
          {
            "arabic": "الصُّبِح، السّاعة سبْعة: واحد، تْنيْن، تلاتة…",
            "latin": "iʂʂúbiɧ, issā3a sáb3a: wāɧad, tnēn, talāta…",
            "english": "In the morning, at seven: one, two, three…"
          },
          {
            "arabic": "المسا، السّاعة عشرة: ساعة ساعة، دْقيقة دْقيقة.",
            "latin": "ilmása, issā3a 3ášara: sā3a sā3a, dgīga dgīga.",
            "english": "In the evening, at ten: hour by hour, minute by minute."
          },
          {
            "arabic": "بُكْرا السّبِت، وأنا هان مِن الصُّبِح.",
            "latin": "búkra issábit, w ána hān min iʂʂúbiɧ.",
            "english": "Tomorrow is Saturday, and I’m here from the morning."
          }
        ]
      }
    },
    {
      "id": "tale:road:5",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 4,
        "regular": "road:5",
        "title": "Rana’s basket",
        "lines": [
          {
            "arabic": "أنا جعان!",
            "latin": "ána ja3ān!",
            "english": "I’m hungry!"
          },
          {
            "arabic": "تْفضّل: خُبِز وجِبْنة وبيْض.",
            "latin": "tfáɖɖal: xúbiz w jíbna w bēɖ.",
            "english": "Here you are: bread, cheese and eggs."
          },
          {
            "arabic": "وقهْوة؟ لا، شاي مع حليب.",
            "latin": "w gáhwa? laʔ, šāy ma3 ɧalīb.",
            "english": "And coffee? No, tea with milk."
          },
          {
            "arabic": "الخُبِز زاكي!",
            "latin": "ilxúbiz zāki!",
            "english": "The bread is delicious!"
          },
          {
            "arabic": "الحْساب؟ لا لا، هالفْطور مِنّي.",
            "latin": "ilɧsāb? laʔ laʔ, halfʈūr mínni.",
            "english": "The bill? No, no, this breakfast is on me."
          }
        ]
      }
    },
    {
      "id": "tale:road:6",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 5,
        "regular": "road:6",
        "title": "Abu Fadi’s drawing",
        "lines": [
          {
            "arabic": "هالدّار دار فادي.",
            "latin": "haddār dār fādi.",
            "english": "This house is Fadi’s house."
          },
          {
            "arabic": "فيها صالوْن ومطْبخ وحمّام.",
            "latin": "fīha ʂālōn w máʈbax w ɧammām.",
            "english": "It has a living room, a kitchen and a bathroom."
          },
          {
            "arabic": "وفي غُرْفة فيها تخِت وشُبّاك.",
            "latin": "w fi ɣúrfa fīha táxit w šubbāk.",
            "english": "And there’s a room with a bed and a window."
          },
          {
            "arabic": "فادي بِنام هان، وبِصْحى الصُّبِح.",
            "latin": "fādi bnām hān, w biʂɧa iʂʂúbiɧ.",
            "english": "Fadi sleeps here, and wakes up in the morning."
          },
          {
            "arabic": "وأنا؟ أنا معي المُفْتاح.",
            "latin": "w ána? ána má3i ilmuftāɧ.",
            "english": "And me? I have the key."
          }
        ]
      }
    },
    {
      "id": "tale:road:7",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 6,
        "regular": "road:7",
        "title": "Nasser shows the way",
        "lines": [
          {
            "arabic": "بِدّك المطار؟",
            "latin": "bíddak ilmaʈār?",
            "english": "You want the airport?"
          },
          {
            "arabic": "مِن هان: قُدّامك، شْمال، يَمين.",
            "latin": "min hān: guddāmak, šmāl, yamīn.",
            "english": "From here: straight on, left, right."
          },
          {
            "arabic": "وَقْتيْش الطّيّارة؟ السّاعة تِسْعة؟",
            "latin": "wagtēš iʈʈayyāra? issā3a tís3a?",
            "english": "When’s the plane? At nine?"
          },
          {
            "arabic": "طيِّب، تاكْسي.",
            "latin": "ʈáyyib, tāksi.",
            "english": "Okay, a taxi."
          },
          {
            "arabic": "السّوّاق بِسوق، وإنْتَ بْتوصل.",
            "latin": "issawwāg bisūg, w ínta btūʂal.",
            "english": "The driver drives, and you arrive."
          }
        ]
      }
    },
    {
      "id": "tale:road:8",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 7,
        "regular": "road:8",
        "title": "Leila paints you",
        "lines": [
          {
            "arabic": "اِبْتسم!",
            "latin": "ibtísim!",
            "english": "Smile!"
          },
          {
            "arabic": "عْيونك سود، وشعرك أسْوَد.",
            "latin": "3yūnak sūd, w šá3rak áswad.",
            "english": "Your eyes are black, and your hair is black."
          },
          {
            "arabic": "وِجْهك طَويل؟ لا، حِلو!",
            "latin": "wíjhak ʈawīl? laʔ, ɧílu!",
            "english": "Your face long? No, handsome!"
          },
          {
            "arabic": "شو بْتِشوف؟ أنا بْشوف أحْمر وأزْرق.",
            "latin": "šū bitšūf? ána bašūf áɧmar w ázrag.",
            "english": "What do you see? I see red and blue."
          },
          {
            "arabic": "هالرّاس راسك، وهالقلْب قلْبك.",
            "latin": "harrās rāsak, w halgalb gálbak.",
            "english": "This head is your head, and this heart is your heart."
          }
        ]
      }
    },
    {
      "id": "tale:road:9",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 8,
        "regular": "road:9",
        "title": "Hassan bargains",
        "lines": [
          {
            "arabic": "هالكيس بِعشرة شيْكِل.",
            "latin": "halkīs b-3ášara šēkil.",
            "english": "This bag is ten shekels."
          },
          {
            "arabic": "غالي؟ لا، رْخيص!",
            "latin": "ɣāli? laʔ, rxīʂ!",
            "english": "Expensive? No, cheap!"
          },
          {
            "arabic": "قدّيْش بِدّك تِدْفع؟",
            "latin": "gaddēš bíddak tídfa3?",
            "english": "How much do you want to pay?"
          },
          {
            "arabic": "خمْسة؟ لا، سبْعة.",
            "latin": "xámsa? laʔ, sáb3a.",
            "english": "Five? No, seven."
          },
          {
            "arabic": "طيِّب، سِتّة، والشّاي مِنّي.",
            "latin": "ʈáyyib, sítta, w iššāy mínni.",
            "english": "Okay, six, and the tea is on me."
          }
        ]
      }
    },
    {
      "id": "tale:road:10",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 9,
        "regular": "road:10",
        "title": "Miss Huda’s class",
        "lines": [
          {
            "arabic": "أنا أُسْتاذة في المدْرسة.",
            "latin": "ána ustāza fi lmádrasa.",
            "english": "I’m a teacher at the school."
          },
          {
            "arabic": "الدّرْس بِبْدا بدْري، السّاعة تمانْيَة.",
            "latin": "iddars bíbda bádri, issā3a tamānya.",
            "english": "The lesson begins early, at eight."
          },
          {
            "arabic": "الطُّلّاب بْيِسْألوا، وأنا بْقول الجَواب.",
            "latin": "iʈʈullāb byisʔalu, w ána bagūl ijjawāb.",
            "english": "The students ask, and I give the answer."
          },
          {
            "arabic": "الجَواب صحّ؟ غلط؟ بِنِتْعلّم.",
            "latin": "ijjawāb ʂaɧɧ? ɣálaʈ? binit3állam.",
            "english": "Is the answer right? Wrong? We learn."
          },
          {
            "arabic": "وبعديْن بقْرا كْتاب.",
            "latin": "w ba3dēn bágra ktāb.",
            "english": "And later I read a book."
          }
        ]
      }
    },
    {
      "id": "tale:road:11",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 10,
        "regular": "road:11",
        "title": "Jamil’s weather",
        "lines": [
          {
            "arabic": "اليوْم الشّمِس حِلْوة.",
            "latin": "ilyōm iššámis ɧílwa.",
            "english": "Today the sun is nice."
          },
          {
            "arabic": "بسّ الهَوا ساقِع، وفي غيْمة.",
            "latin": "bass ilháwa sāgi3, w fi ɣēma.",
            "english": "But the wind is cold, and there’s a cloud."
          },
          {
            "arabic": "أنا تعْبان، بسّ مبْسوط.",
            "latin": "ána ta3bān, bass mabsūʈ.",
            "english": "I’m tired, but happy."
          },
          {
            "arabic": "ليْش؟ عشان القلْب دايْماً بِحِبّ الشِّتا.",
            "latin": "lēš? 3ašān ilgalb dāyman biɧíbb iššíta.",
            "english": "Why? Because the heart always loves the rain."
          },
          {
            "arabic": "اُقْعُد معي، واِسْمع.",
            "latin": "úg3ud má3i, w ísma3.",
            "english": "Sit with me, and listen."
          }
        ]
      }
    },
    {
      "id": "tale:road:12",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 11,
        "regular": "road:12",
        "title": "Samira measures you",
        "lines": [
          {
            "arabic": "هالبالْطو حِلو، بسّ وِسِخ.",
            "latin": "halbālʈō ɧílu, bass wísix.",
            "english": "This coat is nice, but dirty."
          },
          {
            "arabic": "اِشْلح البالْطو! بغْسْلو اليوْم.",
            "latin": "íšlaɧ ilbālʈō! baɣsílu ilyōm.",
            "english": "Take off the coat! I’ll wash it today."
          },
          {
            "arabic": "وهالقميص؟ لوْنو بِنّي غامِق.",
            "latin": "w halgamīʂ? lōnu bínni ɣāmig.",
            "english": "And this shirt? Its color is dark brown."
          },
          {
            "arabic": "بِدّك واحد أزْرق فاتِح؟",
            "latin": "bíddak wāɧad ázrag fātiɧ?",
            "english": "Do you want a light blue one?"
          },
          {
            "arabic": "مع لفْحة زهْري، إنْتَ مْرتّب كْتير!",
            "latin": "ma3 láfɧa záhri, ínta mráttab ktīr!",
            "english": "With a pink scarf, you look very sharp!"
          }
        ]
      }
    },
    {
      "id": "tale:road:13",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 12,
        "regular": "road:13",
        "title": "Abu Sami’s family",
        "lines": [
          {
            "arabic": "هالشّابّ اِبْني، وهالمرا مرْتو.",
            "latin": "haššabb íbni, w halmára mártu.",
            "english": "This young man is my son, and this woman is his wife."
          },
          {
            "arabic": "والرّضيع؟ هُوَّ اِبِن بِنْتي.",
            "latin": "w irraɖī3? húwwa ibn bínti.",
            "english": "And the baby? He’s my daughter’s son."
          },
          {
            "arabic": "عمّو وخالْتو هِناك، مع الْوْلاد.",
            "latin": "3ámmu w xáltu hināk, ma3 ilwlād.",
            "english": "His uncle and his aunt are over there, with the kids."
          },
          {
            "arabic": "أنا عجوز، وبنْسى الأسامي.",
            "latin": "ána 3ajūz, w bánsa ilʔasāmi.",
            "english": "I’m an old man, and I forget the names."
          },
          {
            "arabic": "بسّ بتْزكّر كُلّ وِجِهْ.",
            "latin": "bass badzákkar kull wíjih.",
            "english": "But I remember every face."
          }
        ]
      }
    },
    {
      "id": "tale:road:14",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 13,
        "regular": "road:14",
        "title": "Karim takes your order",
        "lines": [
          {
            "arabic": "شو بِدّك تِفْطر؟",
            "latin": "šū bíddak tífʈar?",
            "english": "What do you want for breakfast?"
          },
          {
            "arabic": "في خُبِز وزِبْدة ولبن وعصير بُرْتْقان.",
            "latin": "fi xúbiz w zíbda w lában w 3aʂīr burtgān.",
            "english": "There’s bread, butter, yogurt and orange juice."
          },
          {
            "arabic": "وقهْوة؟ سادة، أوْ مع سُكّر؟",
            "latin": "w gáhwa? sāda, aw ma3 súkkar?",
            "english": "And coffee? Plain, or with sugar?"
          },
          {
            "arabic": "طيِّب، بجيب القهْوة.",
            "latin": "ʈáyyib, bajīb ilgáhwa.",
            "english": "Okay, I’ll bring the coffee."
          },
          {
            "arabic": "والعشا؟ معْكروْنة مع بنْدوْرة وبصل. لزيز!",
            "latin": "w il3áša? ma3karōna ma3 bandōra w báʂal. lazīz!",
            "english": "And dinner? Pasta with tomatoes and onions. Tasty!"
          }
        ]
      }
    },
    {
      "id": "tale:road:15",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 14,
        "regular": "road:15",
        "title": "Mona’s empty house",
        "lines": [
          {
            "arabic": "هالبيْت فيه حيْطان وأرْض، وبسّ.",
            "latin": "halbēt fī ɧēʈān w arɖ, w bass.",
            "english": "This house has walls and a floor, and that’s all."
          },
          {
            "arabic": "بِدّي لمْبة ومْرايَة ومْخدّة.",
            "latin": "bíddi lámba w mrāya w mxádda.",
            "english": "I want a lamp, a mirror and a pillow."
          },
          {
            "arabic": "والصّورة؟ على الحيْط، فوْق الكنبة.",
            "latin": "w iʂʂūra? 3ála lɧēʈ, fōg ilkánaba.",
            "english": "And the picture? On the wall, over the sofa."
          },
          {
            "arabic": "بفْتح الشُّبّاك، وبعمل قهْوة.",
            "latin": "báftaɧ iššubbāk, w bá3mal gáhwa.",
            "english": "I open the window, and make coffee."
          },
          {
            "arabic": "واليوْم، هالبيْت بيْتي.",
            "latin": "w ilyōm, halbēt bēti.",
            "english": "And today, this house is my home."
          }
        ]
      }
    },
    {
      "id": "tale:road:16",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 15,
        "regular": "road:16",
        "title": "Tariq studies",
        "lines": [
          {
            "arabic": "بُكْرا عِنْدي اِمْتِحان.",
            "latin": "búkra 3índi imtiɧān.",
            "english": "Tomorrow I have a test."
          },
          {
            "arabic": "بدْرُس إنْجْليزي وفرنْسي، وألْماني كمان.",
            "latin": "bádrus inglīzi w faránsi, w almāni kamān.",
            "english": "I study English and French, and German too."
          },
          {
            "arabic": "بسّ العربي صِعِب!",
            "latin": "bass il3árabi ʂí3ib!",
            "english": "But Arabic is hard!"
          },
          {
            "arabic": "بكْتِب كُلّ كِلْمة في الدّفْتر.",
            "latin": "báktib kull kílma fi ddáftar.",
            "english": "I write every word in the notebook."
          },
          {
            "arabic": "إذا ما بفْهمْش، بسْأل الأُسْتاذ.",
            "latin": "íza ma bafhámiš, basʔal ilʔustāz.",
            "english": "If I don’t understand, I ask the teacher."
          }
        ]
      }
    },
    {
      "id": "tale:road:17",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 16,
        "regular": "road:17",
        "title": "Dalia’s bag",
        "lines": [
          {
            "arabic": "معي جرايِد ومجلّات وظْروف.",
            "latin": "má3i jarāyid w majallāt w ʐrūf.",
            "english": "I’ve got newspapers, magazines and envelopes."
          },
          {
            "arabic": "شو عِنْوان هالظّرْف؟",
            "latin": "šū 3inwān haʐʐarf?",
            "english": "What’s the address on this envelope?"
          },
          {
            "arabic": "اليوْم الكُلّ بِبْعت إيميْل.",
            "latin": "ilyōm ilkull bíb3at īmēl.",
            "english": "Today everyone sends an email."
          },
          {
            "arabic": "بسّ الجوّال دايْماً مشْغول، والنِّت فيه مشاكِل.",
            "latin": "bass ijjawwāl dāyman mašɣūl, w innit fī mašākil.",
            "english": "But the phone is always busy, and the internet has problems."
          },
          {
            "arabic": "والبريد؟ البريد دايْماً بوْصل.",
            "latin": "w ilbarīd? ilbarīd dāyman byūʂal.",
            "english": "And the mail? The mail always arrives."
          }
        ]
      }
    },
    {
      "id": "tale:road:18",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 17,
        "regular": "road:18",
        "title": "Fares by the fire",
        "lines": [
          {
            "arabic": "بِالعادة، المسا، بغنّي وبلْعب غيتار.",
            "latin": "bi-l3āda, ilmása, baɣánni w bál3ab gītār.",
            "english": "Usually, in the evening, I sing and play the guitar."
          },
          {
            "arabic": "الشّباب بْيُرْقُصوا، والْوْلاد بْيِلْعبوا.",
            "latin": "iššabāb byúrguʂu, w ilwlād byil3abu.",
            "english": "The young men dance, and the kids play."
          },
          {
            "arabic": "وإنْتَ؟ شو هِوايْتك؟",
            "latin": "w ínta? šū hiwāytak?",
            "english": "And you? What’s your hobby?"
          },
          {
            "arabic": "كوْرة؟ تِنْس؟ بْتِسْبح؟",
            "latin": "kōra? tins? btísbaɧ?",
            "english": "Soccer? Tennis? Do you swim?"
          },
          {
            "arabic": "بلِّش، غنّي معي!",
            "latin": "bálliš, ɣánni má3i!",
            "english": "Go on, sing with me!"
          }
        ]
      }
    },
    {
      "id": "tale:road:19",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 18,
        "regular": "road:19",
        "title": "Amal knows the way",
        "lines": [
          {
            "arabic": "ويْن بِدّك تْروح؟",
            "latin": "wēn bíddak trūɧ?",
            "english": "Where do you want to go?"
          },
          {
            "arabic": "عمّان؟ عاصِمة الأُرْدُن.",
            "latin": "3ammān? 3āʂimt ilʔúrdun.",
            "english": "Amman? The capital of Jordan."
          },
          {
            "arabic": "الباص بِطْلع الصُّبِح، السّاعة سِتّة.",
            "latin": "ilbāʂ bíʈla3 iʂʂúbiɧ, issā3a sítta.",
            "english": "The bus sets off in the morning, at six."
          },
          {
            "arabic": "بِدّك تِكِت؟ وفيزا؟",
            "latin": "bíddak tíkit? w vīza?",
            "english": "You need a ticket? And a visa?"
          },
          {
            "arabic": "طيِّب، إجازة حِلْوة!",
            "latin": "ʈáyyib, ijāza ɧílwa!",
            "english": "Okay, have a nice vacation!"
          }
        ]
      }
    },
    {
      "id": "tale:road:20",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 19,
        "regular": "road:20",
        "title": "Ziad’s mountain",
        "lines": [
          {
            "arabic": "بُكْرا الصُّبِح، بِنْروح على الجبل.",
            "latin": "búkra iʂʂúbiɧ, binrūɧ 3ála ljábal.",
            "english": "Tomorrow morning, we go up the mountain."
          },
          {
            "arabic": "هِناك في عنْزة، وحْمار، وكلْب.",
            "latin": "hināk fi 3ánza, w ɧmār, w kalb.",
            "english": "Up there there’s a goat, a donkey and a dog."
          },
          {
            "arabic": "الكلْب سريع، والحْمار بطيء.",
            "latin": "ilkalb sarī3, w ilɧmār baʈīʔ.",
            "english": "The dog is fast, and the donkey is slow."
          },
          {
            "arabic": "وتحِت الجبل في بُحَيْرة وشجرة كْبيرة.",
            "latin": "w táɧt ijjábal fi buɧēra w šájara kbīra.",
            "english": "And under the mountain there’s a lake and a big tree."
          },
          {
            "arabic": "المسا، بِنْشوف القمر والنِّجْمات.",
            "latin": "ilmása, binšūf ilgámar w innijmāt.",
            "english": "In the evening, we see the moon and the stars."
          }
        ]
      }
    },
    {
      "id": "tale:road:21",
      "subject": "arabic",
      "type": "tale",
      "data": {
        "chapter": 20,
        "regular": "road:21",
        "title": "Abu Nabil’s sums",
        "lines": [
          {
            "arabic": "عِنْدي ألْف كيس.",
            "latin": "3índi alf kīs.",
            "english": "I have a thousand sacks."
          },
          {
            "arabic": "الأحد بِعْت خمْسين، والِاتْنيْن سِتّين.",
            "latin": "ilʔáɧad bi3t xamsīn, w litnēn sittīn.",
            "english": "On Sunday I sold fifty, and on Monday sixty."
          },
          {
            "arabic": "التّلات؟ صِفِر!",
            "latin": "ittalāt? ʂífir!",
            "english": "Tuesday? Zero!"
          },
          {
            "arabic": "قدّيْش عِنْدي اليوْم؟",
            "latin": "gaddēš 3índi ilyōm?",
            "english": "How many do I have today?"
          },
          {
            "arabic": "تمن مية وتِسْعين! صحّ؟",
            "latin": "táman míyya w tis3īn! ʂaɧɧ?",
            "english": "Eight hundred and ninety! Right?"
          }
        ]
      }
    }
  ]
}
